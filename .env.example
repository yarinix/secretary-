# Обязательные
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OWNER_ID=5084782149

# Claude не подключён: в ANTHROPIC_API_KEY лежит ключ GEMINI (название историческое).
# Если заданы оба, приоритет у GEMINI_API_KEY.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Необязательные — дефолты для настроек Mini App (переопределяются в UI без рестарта)
OWNER_NAME=владельца
BOT_TIMEZONE=Asia/Omsk
BUSINESS_MAX_REPLIES_PER_HOUR=20

# Умные отложенные ответы (дефолты; меняются в Mini App без рестарта)
BUSINESS_SMART_REPLIES=1
BUSINESS_REPLY_DELAY_MINUTES=10
BUSINESS_AWAY_MINUTES=60
BUSINESS_AWAY_COLLECT_SECONDS=15
BOT_NIGHT_ENABLED=1
BOT_NIGHT_START=01:00
BOT_NIGHT_END=08:00
BOT_NIGHT_HINT=
BUSINESS_IGNORE_IDS=
DB_PATH=secretary.db

# Внешний Postgres. Если задан — настройки из Mini App НЕ сбрасываются при
# рестарте Render Free. Если пусто — локальный SQLite (эфемерный на Free).
# Пример: postgresql://user:password@host:5432/postgres?sslmode=require
DATABASE_URL=
WEBHOOK_SECRET=
WEBHOOK_BASE_URL=
PORT=10000

# Полный URL Mini App (с /app). Если пусто — берётся WEBHOOK_BASE_URL/RENDER_EXTERNAL_URL + /app.
# На проде: https://secretary-bot-htem.onrender.com/app
WEBAPP_URL=
